{
  "ocr": {
    "default_engine": "tesseract",
    "tesseract_lang": "fra+eng",
    "tesseract_config": "--psm 6",
    "easyocr_languages": ["fr", "en"],
    "confidence_threshold": 0.5
  },
  
  "image_quality": {
    "min_resolution": [800, 600],
    "min_brightness": 50,
    "max_brightness": 200,
    "min_contrast": 30,
    "min_sharpness": 100
  },
  
  "preprocessing": {
    "threshold_value": 150,
    "threshold_type": "binary",
    "denoise_strength": 10,
    "denoise_template_window": 7,
    "denoise_search_window": 21
  },
  
  "extraction_patterns": {
    "fluoro_time": {
      "pattern": "[Ff]luoro.*?time.*?[:\\s]+([0-9]+[.,]?[0-9]*)\\s*(min|s)",
      "description": "Fluoroscopy time in minutes or seconds"
    },
    "total_fluoro_kair": {
      "pattern": "[Tt]otal.*?[Ff]luoro.*?[Kk]air.*?[:\\s]+([0-9]+[.,]?[0-9]*)",
      "description": "Total fluoroscopy Kerma-air product"
    },
    "dose_entree_peau_max": {
      "pattern": "[Dd]ose.*?entr[ée]e.*?peau.*?max.*?[:\\s]+([0-9]+[.,]?[0-9]*)",
      "description": "Maximum entrance skin dose"
    },
    "exposit_ni": {
      "pattern": "[Ee]xposit.*?NI.*?[:\\s]+([0-9]+[.,]?[0-9]*)",
      "description": "Exposure NI value"
    },
    "total_pds": {
      "pattern": "[Tt]otal.*?PDS.*?[:\\s]+([0-9]+[.,]?[0-9]*)",
      "description": "Total PDS (Dose Area Product)"
    },
    "total_dose": {
      "pattern": "[Tt]otal.*?[Dd]ose.*?[:\\s]+([0-9]+[.,]?[0-9]*)",
      "description": "Total radiation dose"
    },
    "frequence_acquisition": {
      "pattern": "[Ff]r[ée]quence.*?acquisition.*?[:\\s]+([0-9]+[.,]?[0-9]*)\\s*[Ff]/[Ss]",
      "description": "Acquisition frequency (Frames per second)"
    }
  },
  
  "validation": {
    "acceptable_error_percentage": 10,
    "outlier_threshold_std": 3,
    "min_samples_for_drls": 20
  },
  
  "statistics": {
    "drl_percentile": 0.75,
    "quartiles": [0.25, 0.5, 0.75],
    "confidence_level": 0.95
  },
  
  "file_paths": {
    "raw_images": "data/raw/",
    "processed_images": "data/processed/",
    "manual_data": "data/manual/",
    "quality_reports": "data/quality_reports/",
    "results_drls": "results/drls/",
    "results_visualizations": "results/visualizations/"
  },
  
  "crop_regions": {
    "total_dap":              {"x": 0, "y": 0, "width": 0, "height": 0},
    "exposure_images":        {"x": 0, "y": 0, "width": 0, "height": 0},
    "fluoro_time":            {"x": 0, "y": 0, "width": 0, "height": 0},
    "air_kerma":              {"x": 0, "y": 0, "width": 0, "height": 0},
    "dose_entree_peau_max":   {"x": 0, "y": 0, "width": 0, "height": 0},
    "total_dose":             {"x": 0, "y": 0, "width": 0, "height": 0},
    "frequence_acquisition":  {"x": 0, "y": 0, "width": 0, "height": 0}
  },

  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "log_file": "pipeline.log"
  }
}
